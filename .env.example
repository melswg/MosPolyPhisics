# Пример локальной конфигурации. Реальные секреты не коммитить.
# Скопируйте файл в .env и задайте значения при необходимости.

# Отдельная БД экспериментальной версии, каталог data/ игнорируется Git.
MOSPHYSICS_DATABASE=data/mosphysics.sqlite
MOSPHYSICS_HOST=127.0.0.1
MOSPHYSICS_PORT=8011

# Публичный адрес будущего preview; локально не требуется.
PUBLIC_BASE_URL=

# Cookie-сессии: в HTTPS ставится true.
SESSION_COOKIE_SECURE=false
CORS_ORIGINS=

# SMTP ещё не предоставлен, значения-заглушки.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true