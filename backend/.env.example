# Example env for backend
# Путь к SQLite (опционально). В Docker по умолчанию /data/database.sqlite
MOSPHYSICS_DATABASE=
MOSPHYSICS_SEED_DEMO=false
PUBLIC_BASE_URL=http://localhost:8000
SESSION_COOKIE_SECURE=false
# CORS origins (comma separated) e.g. http://localhost:3000
CORS_ORIGINS=

# Для восстановления пароля. Не коммитьте реальные значения.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Ежечасная синхронизация публичной таблицы, только status=готово.
# Пустой ID отключает синхронизацию.
MOSPHYSICS_NEWS_SHEET_ID=
MOSPHYSICS_NEWS_SHEET_GID=0
# По умолчанию news-media рядом с SQLite; в Docker /data/news-media.
MOSPHYSICS_NEWS_MEDIA=
# Требуется для ссылок на папки в images; включите Google Drive API.
GOOGLE_DRIVE_API_KEY=
