# Copy values into the private runtime env file, never commit credentials.
SMTP_FROM=noreply@mospolyphysics.ru
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# For implicit TLS on port 465 instead:
# SMTP_PORT=465
# SMTP_USE_TLS=false
# SMTP_USE_SSL=true
